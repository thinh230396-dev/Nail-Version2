<Project>

  <!--
    Thiết lập chung cho mọi project trong solution. Một project chỉ khai báo những gì
    riêng của nó (SDK, tham chiếu); phần còn lại đổi một chỗ là đổi cho cả năm.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!--
      Cảnh báo là lỗi: solution đang build với 0 cảnh báo, và chỉ giữ được con số đó khi
      cảnh báo mới không lọt qua được. Riêng cảnh báo lỗ hổng của NuGet (NU190x) vẫn chỉ là
      cảnh báo — một bản tin bảo mật công bố sáng nay không được làm hỏng bản build chiều nay;
      nó phải được đọc và xử lý có chủ đích.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
